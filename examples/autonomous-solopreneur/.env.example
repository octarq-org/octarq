# Octarq Instance Connection
# Defaults to local dev instance
OCTARQ_URL=http://localhost:8080

# Octarq API Token (Generate in Dashboard -> Personal Settings -> API Tokens)
# Format: oct_...
OCTARQ_TOKEN=oct_dev_token_sample

# Remote MCP Endpoint (Dual SSE / Streamable HTTP)
OCTARQ_MCP_ENDPOINT=http://localhost:8080/api/mcp/sse

# Solopreneur Operational Configuration
SOLOPRENEUR_DOMAIN=solopreneur.dev
SOLOPRENEUR_SHORTLINK_HOST=go.solopreneur.dev
SOLOPRENEUR_MAILBOX=ops@solopreneur.dev

# Ed25519 Licensing Keypair (PEM format or Hex)
# If left blank, the script automatically generates an ephemeral keypair on first run.
SOLOPRENEUR_ED25519_PRIVATE_KEY=
SOLOPRENEUR_ED25519_PUBLIC_KEY=

# Execution Mode: "auto" (uses live instance if reachable, falls back to simulation),
# "live" (fails if Octarq is unreachable), or "simulate" (forces mock simulation)
EXECUTION_MODE=auto
