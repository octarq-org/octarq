{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name identifies the deployed Worker; renaming it would publish a second
  // Worker and strand the first one holding the domain.
  "name": "octarq-docs",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // The landing page and the docs are one build, served on one host.
  // `custom_domain` makes wrangler own the DNS record, so the binding lives
  // here in review rather than in someone's dashboard session.
  //
  // docs., not the apex: octarq.org sells things — pricing, checkout, the legal
  // pages — and all of that is built from the private octarq-pro repo. This is
  // the MIT repo, so it takes the documentation host and leaves commerce where
  // it lives. Claiming the apex here would have served this build there instead
  // and 404'd every /pricing/* URL.
  "routes": [
    {
      "pattern": "docs.octarq.org",
      "custom_domain": true
    }
  ],
  // preview_urls enables per-version preview URLs on workers.dev so that
  // `wrangler versions upload --preview-alias <alias>` produces a stable
  // https://<alias>-octarq-docs.<subdomain>.workers.dev URL without
  // needing a separate worker name or environment.
  "preview_urls": true
}
