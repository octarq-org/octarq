---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import PositioningSection from "../components/landing/PositioningSection.astro";
import PluginsSection from "../components/landing/PluginsSection.astro";
import McpSection from "../components/landing/McpSection.astro";
import FaqSection from "../components/landing/FaqSection.astro";
import CtaSection from "../components/landing/CtaSection.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
import { config } from "virtual:nimbus/config";
import "../styles/landing.css";

const anchors = [
  { href: "#positioning", label: "Why Octarq" },
  { href: "#plugins", label: "Plugins" },
  { href: "#mcp", label: "Agents" },
  { href: "#faq", label: "FAQ" },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="oct-page">
    <Header showSidebar={false} anchors={anchors}>
      <Fragment slot="cta">
        <a class="oct-btn oct-btn--primary oct-header-cta" href="/quickstart/">
          Get started
        </a>
      </Fragment>
    </Header>

    {/* Chrome-level accent glint under the header */}
    <span class="oct-sweep" aria-hidden="true"></span>

    <main id="main-content" class="oct-main">
      <HeroSection />
      <PositioningSection />
      <PluginsSection />
      <McpSection />
      <FaqSection />
      <CtaSection />
    </main>

    <LandingFooter />
  </div>
</BaseLayout>
