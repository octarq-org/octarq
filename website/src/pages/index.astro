---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";

// Real entry points into the docs (replaces the scaffold Welcome/Getting-Started/
// Components cards). Each targets a migrated page in the docs collection.
const entries = [
  { href: "/what-is-octarq/", title: "What is Octarq", blurb: "The one-binary pitch" },
  { href: "/quickstart/", title: "Quickstart", blurb: "Run it in minutes" },
  { href: "/writing-a-plugin/", title: "Writing a Plugin", blurb: "Extend in an afternoon" },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-2xl w-full px-6 py-24">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>
      <p class="mt-4 text-[0.95rem] text-foreground leading-relaxed">
        A single Go binary you extend with plugins — short links, custom-domain
        email, and DNS as first-class plugins, each drivable by your AI agent
        over <strong>MCP</strong>. Own the stack instead of paying three SaaS bills.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          entries.map((e) => (
            <a
              href={e.href}
              class="block rounded-lg border border-border p-4 transition-colors hover:border-border-strong no-underline"
            >
              <div class="font-medium text-foreground">{e.title}</div>
              <div class="mt-0.5 text-sm text-muted-foreground">{e.blurb}</div>
            </a>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-muted-foreground">
        Or browse the docs — <a href="/what-is-octarq/" class="text-foreground underline">Start</a>,
        <a href="/core/short-links/" class="text-foreground underline">Core Features</a>, and
        <a href="/architecture/overview/" class="text-foreground underline">Architecture</a>.
      </p>
    </main>
  </div>
</BaseLayout>
