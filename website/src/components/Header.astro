---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import { config } from "virtual:nimbus/config";
import { getSidebarSections } from "@cloudflare/nimbus-docs";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  /**
   * Landing-page in-page anchors (href + label), rendered next to the lockup
   * in the same style as the cross-page `sections` nav. Only the front door
   * passes these — docs pages leave the prop unset. Unlike `sections`, the
   * links point at `id`s on the current page, so they never carry
   * `aria-current`/active styling. When both `anchors` and `sections` are
   * present they share the one divider line.
   */
  anchors?: { href: string; label: string }[];
  /**
   * Cross-site destination links (Docs, API Reference, Pricing, Cloud).
   * Rendered in the left navigation area. If `anchors` are provided, they take
   * precedence and `destinations` are hidden.
   */
  destinations?: { href: string; label: string; external?: boolean }[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const {
  collection,
  showSidebar = true,
  anchors,
  destinations = (anchors && anchors.length > 0) ? undefined : [
    { href: "/", label: "Docs" },
    { href: "/api-reference/", label: "API Reference" },
    { href: "https://octarq.org/pricing/", label: "Pricing", external: true },
    { href: "https://app.octarq.org/", label: "Cloud", external: true },
  ]
} = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = await getSidebarSections(currentSlug, { collection });
const showSections = sections.length >= 2;
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      {/* Lockup: the Octarq mark plus the wordmark. The mark inherits
          currentColor from the link, so it tracks the light/dark theme
          without a second asset. Geometry is kept in sync by hand with
          web/src/shell/OctarqMark.tsx — the two live in different build
          graphs, so there's no import to share. */}
      <a href="/" class="group flex items-center gap-2">
        <svg
          viewBox="0 0 64 64"
          fill="currentColor"
          aria-hidden="true"
          class="h-[18px] w-[18px] text-primary"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M10,26 C10,13.8 19.8,4 32,4 C44.2,4 54,13.8 54,26 V56 H42 V28 C42,23.6 37.6,20 32,20 C26.4,20 22,23.6 22,28 V56 H10 V26 Z M26,33 H38 V46 H26 V33 Z"
          />
        </svg>
        <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
          {config.title}
        </span>
      </a>

      {(showSections || anchors?.length || destinations?.length) && (
        <nav aria-label="Sections" class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {showSections &&
            sections.map((section) => (
              <a
                href={section.href}
                aria-current={section.isActive ? "page" : undefined}
                class:list={[
                  "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors",
                  section.isActive
                    ? "text-foreground bg-accent"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
                ]}
              >
                {section.label}
              </a>
            ))}
          {destinations?.map((dest) => {
            const isActive = !dest.external && (
              dest.href === "/"
                ? currentSlug === "/" || (currentSlug !== "/" && !currentSlug.startsWith("/api-reference"))
                : currentSlug.startsWith(dest.href)
            );
            return (
              <a
                href={dest.href}
                target={dest.external ? "_blank" : undefined}
                rel={dest.external ? "noopener" : undefined}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors",
                  isActive
                    ? "text-foreground bg-accent"
                    : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
                ]}
              >
                {dest.label}
              </a>
            );
          })}
          {anchors?.map((anchor) => (
            <a
              href={anchor.href}
              class="px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors text-muted-foreground hover:text-foreground hover:bg-accent/60"
            >
              {anchor.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2">
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      )}
      {/* The site's one primary call-to-action, fed in by the landing page;
          last in the row so it holds the strongest position. Empty for docs. */}
      <slot name="cta" />
    </div>
  </div>
</header>
