# --- core (required) ---
OCTARQ_SECRET_KEY="<generate-with: openssl rand -hex 32>"   # signs sessions + encrypts provider creds
OCTARQ_ADMIN_PASSWORD="<your-strong-password>"                        # dashboard login password
OCTARQ_ADMIN_USER=admin

# --- server ---
OCTARQ_LISTEN=:8080
# Docker compose only: host port published by docker-compose. Change if 8080 is
# taken. To change the binary's own listen port use OCTARQ_LISTEN instead.
OCTARQ_PORT=8080
# CORS allowlist for the public API (comma-separated exact origins, e.g.
# https://app.example.com). Empty = CORS disabled; never "*". Only used as a
# startup fallback when the instance setting has not been written yet.
# OCTARQ_CORS_ORIGINS=
# Honour X-Forwarded-For / X-Real-IP for the client IP (rate limiting, abuse) and
# X-Forwarded-Proto when deciding whether a request arrived over HTTPS (which
# marks the session cookie Secure). Enable ONLY behind a trusted reverse proxy;
# otherwise clients can spoof both.
# OCTARQ_TRUST_PROXY=false
# Allow operator-configured webhook / notification targets to reach private or
# loopback addresses. Off by default (blocks SSRF); enable only when your webhook
# receivers run on a trusted internal network.
# OCTARQ_ALLOW_PRIVATE_WEBHOOKS=false
# Allow outbound SMTP mail delivery to reach private or loopback addresses (e.g.
# a local Postfix or Mailhog on 127.0.0.1/LAN). Off by default (blocks SSRF).
# OCTARQ_ALLOW_PRIVATE_SMTP=false
# There is no base-URL, admin-host or secure-cookie variable. Absolute links
# (password reset, email verification, invites, OAuth callbacks) are built from
# the hostname each request arrives on, accepted only when it matches a domain
# registered in the dashboard (Domains); where the dashboard is served and
# whether the session cookie is marked Secure follow from the same request. Add
# the domain this instance answers on to have octarq reject hostnames it does
# not own.

# Shared tenant-subdomain base (bootstrap fallback only). When set, every newly
# created org automatically gets its own address <org-slug>.<base> — no manual
# DNS work per tenant. Needs a wildcard DNS record and a wildcard TLS cert on
# the base, plus OCTARQ_SHARED_HOSTS declaring the base itself. The dashboard
# setting (Settings → Instance → Tenant base domain) overrides this once saved;
# leave empty to keep today's behaviour (no tenant subdomains at all).
# OCTARQ_BASE_DOMAIN=

# Multi-tenant shared entry domains the dashboard answers on (comma-separated).
# REQUIRED when tenant subdomains are in use: registering any domain switches
# off origin's no-whitelist fallback, and without this explicit declaration the
# shared host would build no absolute URLs (password reset, invites).
# OCTARQ_SHARED_HOSTS=app.example.com

# --- database ---
OCTARQ_DB_DRIVER=sqlite        # sqlite | postgres
OCTARQ_DB_DSN=octarq.db           # sqlite: file path | postgres: postgres://user:pass@host:5432/octarq
# Optional Redis for rate limiting / caching (e.g. redis://localhost:6379).
# Empty = Redis-based features fall back to DB / in-memory.
# OCTARQ_REDIS_URL=

# --- analytics (optional) ---
# Path to a MaxMind GeoLite2-City.mmdb for country/city resolution. Empty = geo
# columns stay blank (everything else works). How to obtain + Docker/k8s wiring:
# deploy/GEOIP.md
OCTARQ_GEOIP_DB=
# Easiest path: leave OCTARQ_GEOIP_DB empty and set a free MaxMind license key
# (maxmind.com → Account → Manage License Keys); octarq then auto-downloads
# GeoLite2-City at startup into the data dir (next to the sqlite db) and keeps
# using that file on later starts. Precedence: OCTARQ_GEOIP_DB > already
# downloaded file > this key > geo disabled.
OCTARQ_MAXMIND_LICENSE_KEY=

# --- AI / LLM (optional; powers the built-in AI assists — slug suggestions,
# on-demand email summary — and the Pro Inbox-AI; `octarq mcp` tools themselves need no LLM) ---
# In the Pro build this is configured from the dashboard (Inbox AI → Configure);
# these env vars are the fallback.
OCTARQ_LLM_PROVIDER=claude   # claude | openai | gemini | mistral | cohere | ollama
OCTARQ_LLM_API_KEY=          # cloud key; for claude falls back to ANTHROPIC_API_KEY
OCTARQ_LLM_MODEL=            # override reasoning model (per-provider default if blank)
OCTARQ_LLM_CHEAP_MODEL=      # override cheap classification model (per-provider default if blank)
OCTARQ_LLM_BASE_URL=         # OpenAI-compatible gateway / proxy / local Ollama address

