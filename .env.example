# ── Octarq Configuration Example ─────────────────────────────────────────────
# Copy this file to .env before starting: `cp .env.example .env`

# Required: Secret key for signing sessions and tokens (at least 32 characters)
OCTARQ_SECRET_KEY=octarq-dev-secret-key-change-in-production

# Initial administrator credentials (persisted in database on first boot)
OCTARQ_ADMIN_USER=admin
OCTARQ_ADMIN_PASSWORD=admin

# Server port (default: 8080)
OCTARQ_PORT=8080

# Database Configuration (default: embedded SQLite)
OCTARQ_DB_DRIVER=sqlite
OCTARQ_DB_DSN=/data/octarq.db

# Optional: GeoIP database path for click geographic analytics
# Download free GeoLite2-City.mmdb from MaxMind or see deploy/GEOIP.md
# OCTARQ_GEOIP_DB=/geoip/GeoLite2-City.mmdb
# OCTARQ_MAXMIND_LICENSE_KEY=your_license_key
