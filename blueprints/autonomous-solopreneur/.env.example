# Octarq Autonomous Solopreneur Blueprint Environment Variables

# 1. Hosted Octarq Endpoint & API Credentials (for Remote SSE MCP)
OCTARQ_URL=https://your-octarq-host.com
OCTARQ_API_TOKEN=oct_your_api_token_here

# 2. Local Database & Secrets (for Local Stdio MCP)
OCTARQ_DB_DSN=/var/lib/octarq/data.db
OCTARQ_SECRET_KEY=your_secret_key_here

# 3. Solopreneur Default Settings (Optional)
DEFAULT_SHORTLINK_HOST=go.yourdomain.com
DEFAULT_FALLBACK_URL=https://yourdomain.com
AUTH_INBOX_ADDRESS=auth@yourdomain.com
